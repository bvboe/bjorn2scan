[Unit]
Description=Bjorn2Scan Agent - Host-level security scanning agent
Documentation=https://github.com/bvboe/bjorn2scan
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/var/lib/bjorn2scan/bin/bjorn2scan-agent
Restart=always
RestartSec=5s

# Basic security hardening (compatible with systemd v219+)
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bjorn2scan-agent

# Resource limits
LimitNOFILE=65536
TasksMax=4096

# No memory bound here, unlike the modern unit which sets MemoryMax=60%.
# MemoryMax and percentage values both need systemd 231+, and this unit exists
# for hosts below v232. The cgroup v1 equivalent is MemoryLimit=, which takes
# an absolute byte count only — and a fixed number would be wrong on most
# hosts, so it is left to the operator rather than guessed here.
#
# To bound the agent on a legacy host, uncomment and size it for that host
# (allow ~2GB above steady state for the host filesystem scan). automemlimit
# reads cgroup v1's memory.limit_in_bytes too, so GOMEMLIMIT will follow it:
#MemoryLimit=3G

[Install]
WantedBy=multi-user.target
