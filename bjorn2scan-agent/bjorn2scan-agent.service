[Unit]
Description=Bjorn2Scan Agent - Host-level security scanning agent
Documentation=https://github.com/bvboe/bjorn2scan
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/var/lib/bjorn2scan/bin/bjorn2scan-agent
Restart=always
RestartSec=5s

# Filesystem access - read-only root with selective write access
ProtectSystem=strict
ReadWritePaths=/var/lib/bjorn2scan
ReadWritePaths=/var/log/bjorn2scan
ReadWritePaths=/tmp
# Docker socket access (optional - agent detects availability at runtime)
# Running as root provides access to /var/run/docker.sock when present
# The '-' prefix makes this non-fatal if the socket doesn't exist
BindReadOnlyPaths=-/var/run/docker.sock

# Security hardening - read-only access to most of the system
NoNewPrivileges=true
PrivateTmp=false
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
# Note: User=root is required — the agent scans the whole host filesystem for
# packages/vulnerabilities and needs broad read access. SystemCallFilter and a
# restricted CapabilityBoundingSet are deliberately omitted here because they can
# impair host reading; validate them on a test host before adding.

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bjorn2scan-agent

# Resource limits
LimitNOFILE=65536
TasksMax=4096

# Memory bound. Two reasons this is set rather than left unlimited:
#
# 1. Containment. The agent's host filesystem scan is the heaviest thing it
#    does (syft cataloguing plus a grype match, ~1.5-2GB peak on a large host).
#    Unbounded, a bad scan grows until the kernel OOM killer fires and picks a
#    victim by badness score — which need not be the agent. A bounded agent
#    that gets killed and restarts (Restart=always, above) is strictly better
#    than an unbounded one that can take a database on the same host with it.
#
# 2. It is what makes GOMEMLIMIT work. The agent imports automemlimit, which
#    reads the cgroup's memory.max — specifically memory.max, not memory.high,
#    so MemoryHigh alone would leave GOMEMLIMIT at MaxInt64, i.e. off. With
#    this set, the Go GC becomes progressively more aggressive as the heap
#    approaches the limit instead of racing it. That race is what OOMKilled the
#    Kubernetes pod-scanner 4 times in 17 days on an identical workload.
#
# A percentage rather than an absolute value, because agents run on hosts from
# 2GB VMs to large servers and any fixed number is wrong on most of them. 60%
# leaves the rest of the host with a working majority while clearing the ~2GB a
# large host scan needs on a 4GB box.
#
# Override per host with a drop-in if the default does not suit:
#   systemctl edit bjorn2scan-agent   ->   [Service] / MemoryMax=3G
# GOMEMLIMIT follows whatever value is set, so no code change is needed.
#
# Requires systemd 231+; install.sh selects the -compat unit below v232.
MemoryMax=60%

[Install]
WantedBy=multi-user.target
