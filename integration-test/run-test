#!/bin/bash -x
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
NAMESPACE="${NAMESPACE:-default}"
RELEASE_NAME="${RELEASE_NAME:-bjorn2scan}"
TIMEOUT="${TIMEOUT:-300}"
SCAN_WAIT_TIME="${SCAN_WAIT_TIME:-120}"

# Test results
TESTS_PASSED=0
TESTS_FAILED=0

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[PASS]${NC} $1"
    TESTS_PASSED=$((TESTS_PASSED + 1))
}

log_error() {
    echo -e "${RED}[FAIL]${NC} $1"
    TESTS_FAILED=$((TESTS_FAILED + 1))
}

log_warning() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

run_test() {
    local test_name="$1"
    echo ""
    log_info "Running test: $test_name"
}

# Test 1: Check if namespace exists
test_namespace() {
    run_test "Namespace Existence"
    if kubectl get namespace "$NAMESPACE" &>/dev/null; then
        log_success "Namespace '$NAMESPACE' exists"
        return 0
    else
        log_error "Namespace '$NAMESPACE' does not exist"
        return 1
    fi
}

# Test 2: Check if Helm release is deployed
test_helm_release() {
    run_test "Helm Release Status"
    if helm list -n "$NAMESPACE" | grep -q "$RELEASE_NAME"; then
        local status=$(helm status "$RELEASE_NAME" -n "$NAMESPACE" -o json | jq -r '.info.status')
        if [ "$status" = "deployed" ]; then
            log_success "Helm release '$RELEASE_NAME' is deployed"
            return 0
        else
            log_error "Helm release '$RELEASE_NAME' status is '$status'"
            return 1
        fi
    else
        log_error "Helm release '$RELEASE_NAME' not found"
        return 1
    fi
}

# Test 3: Check if all pods are running
test_pods_running() {
    run_test "Pod Status"
    local all_running=true

    # Check pod-scanner (DaemonSet)
    local pod_scanner_desired=$(kubectl get daemonset pod-scanner -n "$NAMESPACE" -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || echo "0")
    local pod_scanner_ready=$(kubectl get daemonset pod-scanner -n "$NAMESPACE" -o jsonpath='{.status.numberReady}' 2>/dev/null || echo "0")

    if [ "$pod_scanner_desired" -gt 0 ] && [ "$pod_scanner_ready" -eq "$pod_scanner_desired" ]; then
        log_success "pod-scanner: $pod_scanner_ready/$pod_scanner_desired pods ready"
    else
        log_error "pod-scanner: $pod_scanner_ready/$pod_scanner_desired pods ready"
        all_running=false
    fi

    # Check vulnerability-coordinator (Deployment)
    local vc_desired=$(kubectl get deployment vulnerability-coordinator -n "$NAMESPACE" -o jsonpath='{.spec.replicas}' 2>/dev/null || echo "0")
    local vc_ready=$(kubectl get deployment vulnerability-coordinator -n "$NAMESPACE" -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo "0")

    if [ "$vc_desired" -gt 0 ] && [ "$vc_ready" -eq "$vc_desired" ]; then
        log_success "vulnerability-coordinator: $vc_ready/$vc_desired pods ready"
    else
        log_error "vulnerability-coordinator: $vc_ready/$vc_desired pods ready"
        all_running=false
    fi

    # Check web-frontend (Deployment)
    local wf_desired=$(kubectl get deployment web-frontend -n "$NAMESPACE" -o jsonpath='{.spec.replicas}' 2>/dev/null || echo "0")
    local wf_ready=$(kubectl get deployment web-frontend -n "$NAMESPACE" -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo "0")

    if [ "$wf_desired" -gt 0 ] && [ "$wf_ready" -eq "$wf_desired" ]; then
        log_success "web-frontend: $wf_ready/$wf_desired pods ready"
    else
        log_error "web-frontend: $wf_ready/$wf_desired pods ready"
        all_running=false
    fi

    if [ "$all_running" = true ]; then
        return 0
    else
        return 1
    fi
}

# Test 4: Check if services are accessible
test_services() {
    run_test "Service Endpoints"
    local all_services_ok=true

    # Check vulnerability-coordinator service
    if kubectl get service vulnerability-coordinator -n "$NAMESPACE" &>/dev/null; then
        local vc_endpoints=$(kubectl get endpoints vulnerability-coordinator -n "$NAMESPACE" -o jsonpath='{.subsets[*].addresses[*].ip}' 2>/dev/null)
        if [ -n "$vc_endpoints" ]; then
            log_success "vulnerability-coordinator service has endpoints: $vc_endpoints"
        else
            log_error "vulnerability-coordinator service has no endpoints"
            all_services_ok=false
        fi
    else
        log_error "vulnerability-coordinator service not found"
        all_services_ok=false
    fi

    # Check web-frontend service
    if kubectl get service web-frontend -n "$NAMESPACE" &>/dev/null; then
        local wf_endpoints=$(kubectl get endpoints web-frontend -n "$NAMESPACE" -o jsonpath='{.subsets[*].addresses[*].ip}' 2>/dev/null)
        if [ -n "$wf_endpoints" ]; then
            log_success "web-frontend service has endpoints: $wf_endpoints"
        else
            log_error "web-frontend service has no endpoints"
            all_services_ok=false
        fi
    else
        log_error "web-frontend service not found"
        all_services_ok=false
    fi

    if [ "$all_services_ok" = true ]; then
        return 0
    else
        return 1
    fi
}

# Test 5: Check web frontend accessibility
test_web_frontend() {
    run_test "Web Frontend Accessibility"

    # Get a vulnerability-coordinator pod to test from (has wget)
    local test_pod=$(kubectl get pods -n "$NAMESPACE" -l app=vulnerability-coordinator -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)

    if [ -z "$test_pod" ]; then
        log_error "No vulnerability-coordinator pod found to run test from"
        return 1
    fi

    # Test HTTP request to the web-frontend service
    local response=$(kubectl exec -n "$NAMESPACE" "$test_pod" -- wget -q -O- http://web-frontend 2>/dev/null || echo "")

    if echo "$response" | grep -q "<!DOCTYPE html>"; then
        log_success "Web frontend is responding with HTML content"
        return 0
    else
        log_error "Web frontend is not responding with expected HTML"
        return 1
    fi
}

# Test 6: Check vulnerability-coordinator API
test_vulnerability_coordinator_api() {
    run_test "Vulnerability Coordinator API"

    # Get vulnerability-coordinator pod
    local pod=$(kubectl get pods -n "$NAMESPACE" -l app=vulnerability-coordinator -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)

    if [ -z "$pod" ]; then
        log_error "No vulnerability-coordinator pod found"
        return 1
    fi

    # Test health endpoint (/api/hello)
    local health=$(kubectl exec -n "$NAMESPACE" "$pod" -- wget -q -O- http://localhost:8080/api/hello 2>/dev/null || echo "")

    if [ -n "$health" ]; then
        log_success "Vulnerability coordinator API endpoint is responding"
    else
        log_error "Vulnerability coordinator API endpoint is not responding"
        return 1
    fi

    # Test metrics endpoint (just verify it responds, not that scans are complete)
    local metrics=$(kubectl exec -n "$NAMESPACE" "$pod" -- wget -q -O- http://localhost:8080/metrics 2>/dev/null || echo "")

    if [ -n "$metrics" ]; then
        log_success "Vulnerability coordinator metrics endpoint is responding"
        # Check if scans have started (optional - may not have data yet)
        if echo "$metrics" | grep -q "kubernetes_vulnerability"; then
            log_success "Vulnerability metrics are already available"
        fi
        return 0
    else
        log_error "Vulnerability coordinator metrics endpoint is not responding"
        return 1
    fi
}

# Test 7: Check pod-scanner health
test_pod_scanner() {
    run_test "Pod Scanner Health"

    # Get first pod-scanner pod
    local pod=$(kubectl get pods -n "$NAMESPACE" -l app=pod-scanner -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)

    if [ -z "$pod" ]; then
        log_error "No pod-scanner pod found"
        return 1
    fi

    # Test health endpoint
    local health=$(kubectl exec -n "$NAMESPACE" "$pod" -- wget -q -O- http://localhost:8080/health 2>/dev/null || echo "")

    if [ -n "$health" ]; then
        log_success "Pod scanner health endpoint is responding"
        return 0
    else
        log_error "Pod scanner health endpoint is not responding"
        return 1
    fi
}

# Test 8: Wait for and verify scan data
test_scan_data() {
    run_test "Vulnerability Scan Data"

    # Get vulnerability-coordinator pod
    local pod=$(kubectl get pods -n "$NAMESPACE" -l app=vulnerability-coordinator -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)

    if [ -z "$pod" ]; then
        log_error "No vulnerability-coordinator pod found"
        return 1
    fi

    log_info "Polling for scan data (timeout: ${SCAN_WAIT_TIME}s)..."

    local elapsed=0
    local poll_interval=5
    local scan_found=false

    while [ $elapsed -lt "$SCAN_WAIT_TIME" ]; do
        # Check metrics for scan data
        local metrics=$(kubectl exec -n "$NAMESPACE" "$pod" -- wget -q -O- http://localhost:8080/metrics 2>/dev/null || echo "")

        # Check if we have scanned containers
        if echo "$metrics" | grep -q "kubernetes_vulnerability_scanned_instances"; then
            local scanned=$(echo "$metrics" | grep "kubernetes_vulnerability_scanned_instances" | head -1 | awk '{print $2}')
            if [ -n "$scanned" ] && [ "$scanned" != "0" ]; then
                scan_found=true
                log_success "Found scan data after ${elapsed}s: containers scanned"

                # Check if we have vulnerability results
                if echo "$metrics" | grep -q "kubernetes_vulnerability_results"; then
                    log_success "Vulnerability results are being reported"
                    return 0
                else
                    log_success "Scans completed (no vulnerabilities found or still processing)"
                    return 0
                fi
            fi
        fi

        # If no data yet, wait and try again
        if [ "$scan_found" = false ]; then
            echo -n "."
            sleep $poll_interval
            elapsed=$((elapsed + poll_interval))
        fi
    done

    echo ""
    log_error "Timeout waiting for scan data after ${SCAN_WAIT_TIME}s"
    return 1
}

# Test 9: Check pod logs for errors
test_pod_logs() {
    run_test "Pod Logs Error Check"
    local errors_found=false

    # Check vulnerability-coordinator logs
    local vc_pod=$(kubectl get pods -n "$NAMESPACE" -l app=vulnerability-coordinator -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    if [ -n "$vc_pod" ]; then
        local vc_errors=$(kubectl logs -n "$NAMESPACE" "$vc_pod" --tail=100 | grep -i "error" | grep -v "ERROR - 0" | wc -l)
        if [ "$vc_errors" -eq 0 ]; then
            log_success "vulnerability-coordinator logs: No errors found"
        else
            log_warning "vulnerability-coordinator logs: $vc_errors error lines found (check manually)"
        fi
    fi

    # Check pod-scanner logs
    local ps_pod=$(kubectl get pods -n "$NAMESPACE" -l app=pod-scanner -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    if [ -n "$ps_pod" ]; then
        local ps_errors=$(kubectl logs -n "$NAMESPACE" "$ps_pod" --tail=100 | grep -i "error" | grep -v "ERROR - 0" | wc -l)
        if [ "$ps_errors" -eq 0 ]; then
            log_success "pod-scanner logs: No errors found"
        else
            log_warning "pod-scanner logs: $ps_errors error lines found (check manually)"
        fi
    fi

    return 0
}

# Test 10: Check cluster roles and permissions
test_rbac() {
    run_test "RBAC Configuration"

    # Check if ServiceAccount exists
    if kubectl get serviceaccount vulnerability-scanner -n "$NAMESPACE" &>/dev/null; then
        log_success "ServiceAccount 'vulnerability-scanner' exists"
    else
        log_error "ServiceAccount 'vulnerability-scanner' not found"
        return 1
    fi

    # Check if ClusterRole exists
    local clusterrole_name="${NAMESPACE}-vulnerability-scanner"
    if kubectl get clusterrole "$clusterrole_name" &>/dev/null; then
        log_success "ClusterRole '$clusterrole_name' exists"
    else
        log_error "ClusterRole '$clusterrole_name' not found"
        return 1
    fi

    # Check if ClusterRoleBinding exists
    local clusterrolebinding_name="${NAMESPACE}-vulnerability-scanner"
    if kubectl get clusterrolebinding "$clusterrolebinding_name" &>/dev/null; then
        log_success "ClusterRoleBinding '$clusterrolebinding_name' exists"
        return 0
    else
        log_error "ClusterRoleBinding '$clusterrolebinding_name' not found"
        return 1
    fi
}

# Main test execution
main() {
    echo "======================================"
    echo "Bjørn2Scan Integration Test Suite"
    echo "======================================"
    echo ""
    log_info "Testing deployment in namespace: $NAMESPACE"
    log_info "Release name: $RELEASE_NAME"
    echo ""

    # Run all tests
    test_namespace || true
    test_helm_release || true
    test_rbac || true
    test_pods_running || true
    test_services || true
    test_pod_scanner || true
    test_vulnerability_coordinator_api || true
    test_web_frontend || true
    test_scan_data || true
    test_pod_logs || true

    # Print summary
    echo ""
    echo "======================================"
    echo "Test Summary"
    echo "======================================"
    log_success "Tests passed: $TESTS_PASSED"
    if [ "$TESTS_FAILED" -gt 0 ]; then
        log_error "Tests failed: $TESTS_FAILED"
        echo ""
        exit 1
    else
        echo ""
        log_success "All tests passed!"
        exit 0
    fi
}

# Run main
main
